DROP_ZONE=~/eBay_Drop
DATABASE_PATH=data/ebay_engine.db
HOST=127.0.0.1
PORT=8787

# eBay API integration. Keep real values in .env only.
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ALLOW_PRODUCTION_PUBLISH=false

# Legacy/current sandbox fallback. Existing local sandbox setups may use these.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_USER_ACCESS_TOKEN=
EBAY_REFRESH_TOKEN=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_DEFAULT_CATEGORY_ID=
EBAY_PUBLIC_IMAGE_BASE_URL=

# Preferred sandbox profile fields.
EBAY_SANDBOX_MARKETPLACE_ID=EBAY_US
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_REDIRECT_URI=
EBAY_SANDBOX_USER_ACCESS_TOKEN=
EBAY_SANDBOX_REFRESH_TOKEN=
EBAY_SANDBOX_PAYMENT_POLICY_ID=
EBAY_SANDBOX_RETURN_POLICY_ID=
EBAY_SANDBOX_FULFILLMENT_POLICY_ID=
EBAY_SANDBOX_MERCHANT_LOCATION_KEY=
EBAY_SANDBOX_DEFAULT_CATEGORY_ID=

# Production profile fields. Fill these before switching to production mode.
EBAY_PRODUCTION_MARKETPLACE_ID=EBAY_US
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_REDIRECT_URI=
EBAY_PRODUCTION_USER_ACCESS_TOKEN=
EBAY_PRODUCTION_REFRESH_TOKEN=
EBAY_PRODUCTION_PAYMENT_POLICY_ID=
EBAY_PRODUCTION_RETURN_POLICY_ID=
EBAY_PRODUCTION_FULFILLMENT_POLICY_ID=
EBAY_PRODUCTION_MERCHANT_LOCATION_KEY=
EBAY_PRODUCTION_DEFAULT_CATEGORY_ID=

# Future secrets, leave blank for MVP:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
APPROVAL_PHONE_NUMBER=
